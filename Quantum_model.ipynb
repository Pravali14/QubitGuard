# ========================================================================
# SECTION 12: DEPLOYMENT INFERENCE FUNCTION
# ========================================================================

def qubitguard_predict(email_features: np.ndarray, 
                       xgb_model, qnn_weights, 
                       ensemble_weights: Dict[str, float],
                       config: QubitGuardConfig) -> Dict[str, any]:
    """
    Production inference function for QubitGuard.
    
    Args:
        email_features: Feature vector for an email (shape: n_features)
        xgb_model: Trained XGBoost model
        qnn_weights: Trained QNN weights
        ensemble_weights: Dictionary with 'xgb' and 'qnn' weights
        config: Configuration object
        
    Returns:
        Dictionary with prediction, probability, and risk level
    """
    # XGBoost prediction
    xgb_proba = xgb_model.predict_proba(email_features.reshape(1, -1))[0, 1]
    
    # QNN prediction
    qnn = QuantumNeuralNetwork(config)
    qnn.weights = qnn_weights
    qnn_proba = qnn.predict(email_features.reshape(1, -1))[0]
    
    # Ensemble fusion
    hybrid_proba = (ensemble_weights['xgb'] * xgb_proba + 
                   ensemble_weights['qnn'] * qnn_proba)
    
    # Risk classification
    if hybrid_proba > 0.8:
        risk_level = "CRITICAL"
    elif hybrid_proba > 0.6:
        risk_level = "HIGH"
    elif hybrid_proba > 0.4:
        risk_level = "MEDIUM"
    else:
        risk_level = "LOW"
    
    return {
        'is_phishing': bool(hybrid_proba > 0.5),
        'probability': float(hybrid_proba),
        'risk_level': risk_level,
        'xgb_score': float(xgb_proba),
        'qnn_score': float(qnn_proba)
    }

# Example usage
