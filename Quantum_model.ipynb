def generate_phishing_dataset(config: QubitGuardConfig) -> Tuple[np.ndarray, np.ndarray]:
    """
    Generate realistic synthetic phishing detection data.
    
    Features simulate real-world phishing indicators:
    - URL length patterns
    - Suspicious keyword density
    - Domain age indicators
    - HTTPS/security certificate features
    
    Returns:
        X: Feature matrix (n_samples, n_features)
        y: Labels (0=legitimate, 1=phishing)
    """
    print("\n" + "="*70)
    print("GENERATING REALISTIC PHISHING DATASET")
    print("="*70)
    
    # Use make_classification for more realistic data distribution
    X, y = make_classification(
        n_samples=config.N_SAMPLES,
        n_features=config.N_FEATURES,
        n_informative=config.N_FEATURES - 1,  # Most features are informative
        n_redundant=1,
        n_clusters_per_class=2,  # Multiple phishing patterns
        flip_y=0.1,  # 10% label noise (realistic for phishing)
        class_sep=0.8,  # Not perfectly separable
        random_state=config.RANDOM_STATE
    )
    
    # Normalize to [0, π] range for quantum encoding
    scaler = StandardScaler()
    X = scaler.fit_transform(X)
    X = (X - X.min()) / (X.max() - X.min()) * np.pi
    
    print(f"✓ Generated {config.N_SAMPLES} samples with {config.N_FEATURES} features")
    print(f"  - Legitimate emails: {np.sum(y == 0)} ({np.sum(y == 0)/len(y)*100:.1f}%)")
    print(f"  - Phishing emails: {np.sum(y == 1)} ({np.sum(y == 1)/len(y)*100:.1f}%)")
    
    return X, y

# Generate dataset
np.random.seed(config.RANDOM_STATE)
X, y = generate_phishing_dataset(config)

# Train-test split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, 
    test_size=config.TEST_SIZE, 
    random_state=config.RANDOM_STATE,
    stratify=y  # Maintain class balance
)

print(f"\n✓ Dataset split:")
print(f"  - Training set: {len(X_train)} samples")
print(f"  - Test set: {len(X_test)} samples")

