@dataclass
class QubitGuardConfig:
    """Centralized configuration for QubitGuard system."""
    
    # Quantum Parameters
    N_QUBITS: int = 4
    N_LAYERS: int = 2
    N_ROTATION_WEIGHTS: int = N_QUBITS * N_LAYERS
    
    # Dataset Parameters
    N_SAMPLES: int = 1000
    N_FEATURES: int = N_QUBITS  # Must match N_QUBITS
    TEST_SIZE: float = 0.3
    RANDOM_STATE: int = 42
    
    # Training Parameters
    QNN_OPTIMIZER: str = 'COBYLA'
    QNN_MAX_ITER: int = 100
    XGB_ESTIMATORS: int = 50
    XGB_MAX_DEPTH: int = 6
    XGB_LEARNING_RATE: float = 0.1
    
    # Ensemble Parameters
    USE_LEARNED_ENSEMBLE: bool = True
    FALLBACK_XGB_WEIGHT: float = 0.6
    FALLBACK_QNN_WEIGHT: float = 0.4
    
    # Visualization Parameters
    FIGSIZE: Tuple[int, int] = (10, 6)
    DPI: int = 100

config = QubitGuardConfig()
