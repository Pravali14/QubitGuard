def train_xgboost_layer(X_train, y_train, config: QubitGuardConfig):
    """Train XGBoost as the classical preprocessing layer."""
    print("\n" + "="*70)
    print("TRAINING XGBOOST PREPROCESSING LAYER")
    print("="*70)
    
    xgb_model = XGBClassifier(
        n_estimators=config.XGB_ESTIMATORS,
        max_depth=config.XGB_MAX_DEPTH,
        learning_rate=config.XGB_LEARNING_RATE,
        eval_metric='logloss',
        random_state=config.RANDOM_STATE,
        verbosity=0
    )
    
    start_time = time.time()
    xgb_model.fit(X_train, y_train)
    train_time = time.time() - start_time
    
    # Evaluate on training set
    train_acc = xgb_model.score(X_train, y_train)
    
    print(f"✓ XGBoost training complete in {train_time:.2f}s")
    print(f"  - Training accuracy: {train_acc:.4f}")
    print(f"  - Model parameters: {xgb_model.get_params()}")
    
    return xgb_model

xgb_model = train_xgboost_layer(X_train, y_train, config)
xgb_train_proba = xgb_model.predict_proba(X_train)[:, 1]
xgb_test_proba = xgb_model.predict_proba(X_test)[:, 1]

# ========================================================================
# SECTION 6: QUANTUM NEURAL NETWORK LAYER
# ========================================================================

class QuantumNeuralNetwork:
    """
    Quantum Neural Network using variational quantum circuits.
    Implements ZZ Heatmap encoding + Hardware-Efficient Ansatz.
    """
    
    def __init__(self, config: QubitGuardConfig):
        self.config = config
        self.weights = None
        self.training_history = []
        
    def create_circuit(self, weights: np.ndarray, features: np.ndarray) -> QuantumCircuit:
        """
        Build quantum circuit with feature encoding and variational layers.
        
        Args:
            weights: Variational parameters for the ansatz
            features: Input features to encode
            
        Returns:
            Quantum circuit ready for simulation
        """
        qc = QuantumCircuit(self.config.N_QUBITS)
        
        # === ENCODING LAYER: ZZ Heatmap ===
        # RX rotations for feature embedding
        for i in range(self.config.N_QUBITS):
            qc.rx(features[i], i)
        
        # CZ entanglement (ZZ-like interaction)
        for i in range(self.config.N_QUBITS - 1):
            qc.cz(i, i + 1)
        qc.barrier(label='Encoding')
        
        # === VARIATIONAL ANSATZ: Hardware-Efficient Ansatz ===
        w_idx = 0
        for layer in range(self.config.N_LAYERS):
            # RY rotations (trainable parameters)
            for i in range(self.config.N_QUBITS):
                if w_idx < len(weights):
                    qc.ry(weights[w_idx], i)
                    w_idx += 1
            
            # CNOT entanglement
            for i in range(self.config.N_QUBITS - 1):
                qc.cx(i, i + 1)
            
            qc.barrier(label=f'Layer_{layer+1}')
        
        return qc
    
    def predict_single(self, weights: np.ndarray, features: np.ndarray) -> float:
        """
        Predict single sample using quantum circuit.
        
        Returns:
            Expectation value in range [-1, 1]
        """
        try:
            qc = self.create_circuit(weights, features)
            statevector = Statevector(qc)
            probs_dict = statevector.probabilities_dict()
            
            # Calculate P(0) and P(1) for first qubit
            P_0, P_1 = 0.0, 0.0
            for outcome, prob in probs_dict.items():
                if outcome[-1] == '0':
                    P_0 += prob
                else:
                    P_1 += prob
            
            # Expectation value <Z_0> = P(0) - P(1)
            return P_0 - P_1
            
        except Exception as e:
            print(f"Warning: Circuit simulation failed - {e}")
            return 0.0
    
    def predict_batch(self, weights: np.ndarray, X: np.ndarray) -> np.ndarray:
        """Predict multiple samples."""
        return np.array([self.predict_single(weights, x) for x in X])
    
    def cost_function(self, weights: np.ndarray, X: np.ndarray, y: np.ndarray) -> float:
        """
        Cost function for training the QNN.
        Uses mean squared error between predictions and labels.
        """
        predictions = self.predict_batch(weights, X)
        # Map labels from {0,1} to {-1,1} to match QNN output range
        y_mapped = 2 * y - 1
        cost = np.mean((predictions - y_mapped) ** 2)
        
        # Store training progress
        self.training_history.append(cost)
        
        return cost
    
    def train(self, X: np.ndarray, y: np.ndarray) -> np.ndarray:
        """
        Train the quantum neural network using classical optimization.
        
        Args:
            X: Training features
            y: Training labels
            
        Returns:
            Optimized weights
        """
        print("\n" + "="*70)
        print("TRAINING QUANTUM NEURAL NETWORK")
        print("="*70)
        print(f"Optimizer: {self.config.QNN_OPTIMIZER}")
        print(f"Max iterations: {self.config.QNN_MAX_ITER}")
        print(f"Training samples: {len(X)}")
        
        # Initialize random weights
        initial_weights = np.random.uniform(0, 2*np.pi, self.config.N_ROTATION_WEIGHTS)
        
        # Progress callback
        def callback(weights):
            if len(self.training_history) % 10 == 0:
                print(f"  Iteration {len(self.training_history)}: Cost = {self.training_history[-1]:.6f}")
        
        start_time = time.time()
        
        # Optimize using scipy
        result = minimize(
            fun=self.cost_function,
            x0=initial_weights,
            args=(X, y),
            method=self.config.QNN_OPTIMIZER,
            options={'maxiter': self.config.QNN_MAX_ITER},
            callback=callback
        )
        
        train_time = time.time() - start_time
        
        self.weights = result.x
        
        print(f"\n✓ QNN training complete in {train_time:.2f}s")
        print(f"  - Final cost: {result.fun:.6f}")
        print(f"  - Optimization success: {result.success}")
        print(f"  - Total iterations: {len(self.training_history)}")
        
        return self.weights
    
    def predict(self, X: np.ndarray) -> np.ndarray:
        """Predict using trained weights."""
        if self.weights is None:
            raise ValueError("Model not trained. Call train() first.")
        
        raw_output = self.predict_batch(self.weights, X)
        # Map from [-1, 1] to [0, 1] probability
        return np.clip((raw_output + 1) / 2, 0, 1)

# Initialize and train QNN
qnn = QuantumNeuralNetwork(config)
qnn_weights = qnn.train(X_train, y_train)

# Generate predictions
qnn_train_proba = qnn.predict(X_train)
qnn_test_proba = qnn.predict(X_test)

# ========================================================================
# SECTION 7: ENSEMBLE FUSION (ASCERY LOGIC)
# ========================================================================

def train_ensemble_fusion(xgb_proba: np.ndarray, qnn_proba: np.ndarray, 
                         y_true: np.ndarray, config: QubitGuardConfig):
    """
    Train ensemble fusion layer using logistic regression.
    This learns optimal weights for combining XGBoost and QNN predictions.
    """
    print("\n" + "="*70)
    print("TRAINING ENSEMBLE FUSION LAYER")
    print("="*70)
    
    if config.USE_LEARNED_ENSEMBLE:
        # Stack predictions as features
        meta_features = np.column_stack([xgb_proba, qnn_proba])
        
        # Train meta-model
        meta_model = LogisticRegression(random_state=config.RANDOM_STATE)
        meta_model.fit(meta_features, y_true)
        
        # Extract learned weights
        xgb_weight = meta_model.coef_[0][0]
        qnn_weight = meta_model.coef_[0][1]
        
        # Normalize weights
        total = abs(xgb_weight) + abs(qnn_weight)
        xgb_weight = abs(xgb_weight) / total
        qnn_weight = abs(qnn_weight) / total
        
        print(f"✓ Learned ensemble weights:")
        print(f"  - XGBoost: {xgb_weight:.3f}")
        print(f"  - QNN: {qnn_weight:.3f}")
        
        return meta_model, xgb_weight, qnn_weight
    else:
        print(f"✓ Using fixed ensemble weights:")
        print(f"  - XGBoost: {config.FALLBACK_XGB_WEIGHT:.3f}")
        print(f"  - QNN: {config.FALLBACK_QNN_WEIGHT:.3f}")
        
        return None, config.FALLBACK_XGB_WEIGHT, config.FALLBACK_QNN_WEIGHT

meta_model, xgb_weight, qnn_weight = train_ensemble_fusion(
    xgb_train_proba, qnn_train_proba, y_train, config
)

# Generate hybrid predictions
if meta_model is not None:
    # Use meta-model
    meta_features_test = np.column_stack([xgb_test_proba, qnn_test_proba])
    hybrid_test_proba = meta_model.predict_proba(meta_features_test)[:, 1]
else:
    # Use weighted average
    hybrid_test_proba = (xgb_weight * xgb_test_proba) + (qnn_weight * qnn_test_proba)

hybrid_test_pred = (hybrid_test_proba > 0.5).astype(int)

