# --- 1. Library Imports ---
import numpy as np
import matplotlib.pyplot as plt
import pickle
from sklearn.model_selection import train_test_split
from sklearn.metrics import confusion_matrix, accuracy_score, precision_score, recall_score, f1_score, roc_auc_score
from xgboost import XGBClassifier

# Qiskit Imports (The core of the quantum logic)
from qiskit.visualization import plot_bloch_multivector
from qiskit import QuantumCircuit
from qiskit.quantum_info import Statevector
from IPython.display import display

# --- 2. Parameters ---
# The QubitGuard Quantum Core uses 10-20 qubits (N_QUBITS).
N_QUBITS = 4 # Using a smaller number for faster simulation/demonstration
N_FEATURES = N_QUBITS
N_LAYERS = 2
N_ROTATION_WEIGHTS = N_QUBITS * N_LAYERS

# --- 3. Synthetic Data Generation ---
print("Generating synthetic data...")
np.random.seed(42)
X = np.random.rand(100, N_FEATURES)
y = (X.sum(axis=1) > 2).astype(int)
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)
print(f"Dataset split: Train={len(X_train)}, Test={len(X_test)}")

# --- 4. QubitGuard Classical Preprocessing (XGBoost Layer) ---
print("\n--- 4. XGBoost Preprocessing/Initial Classifier ---")
try:
    xgb_model = XGBClassifier(use_label_encoder=False, eval_metric='logloss', n_estimators=10, random_state=42)
except:
    xgb_model = XGBClassifier(eval_metric='logloss', n_estimators=10, random_state=42)
xgb_model.fit(X_train, y_train)
xgb_pred_proba = xgb_model.predict_proba(X_test)[:, 1]

# --- 5. QubitGuard Quantum Core (Hybrid Quantum Neural Network - Qiskit) ---

def create_qiskit_ansatz(qc: QuantumCircuit, weights: np.ndarray, features: np.ndarray, n_qubits: int, n_layers: int):
    """
    Builds the QubitGuard quantum circuit using Qiskit.
    It combines the ZZ Heatmap Encoding with a Hardware-Efficient Ansatz (HEA).
    """

    # a) ZZ Heatmap Encoding/Entanglement (Feature Map - RX and CZ)
    # RX gates for feature embedding (AngleEmbedding rotation='X' is RX(2*x))
    for i in range(n_qubits):
        qc.rx(2 * features[i], i)
    # CZ Entanglement (R_ZZ-like)
    for i in range(n_qubits - 1):
        qc.cz(i, i+1)
    qc.barrier()

    # b) Variational Ansatz (Qiskit HEA - RY and CNOT)
    w_index = 0
    for layer in range(n_layers):
        # Single-qubit rotations (RY)
        for i in range(n_qubits):
            if w_index < len(weights):
                qc.ry(weights[w_index], i)
                w_index += 1

        # Entangling layer (Linear CNOT/CX)
        for i in range(n_qubits - 1):
            qc.cx(i, i+1)

        qc.barrier()

def qiskit_classifier(weights: np.ndarray, features: np.ndarray) -> float:
    """
    Simulates the Qiskit circuit and calculates the expectation value <Z0>.
    """
    n_qubits = len(features)
    qc = QuantumCircuit(n_qubits)

    # Build the full circuit
    create_qiskit_ansatz(qc, weights, features, n_qubits, N_LAYERS)

    # Expectation Value Calculation (<Z0>)
    # Using Statevector for simulation
    statevector = Statevector(qc)

    # Get probabilities of measuring qubit 0
    # The probabilities_dict() method in Qiskit 1.0+ no longer accepts the 'qubits' argument.
    # We manually sum probabilities based on the state of qubit 0.
    full_probabilities = statevector.probabilities_dict()

    P_0 = 0.0
    P_1 = 0.0
    for outcome, prob in full_probabilities.items():
        # The outcome string is ordered as q_n-1 ... q_1 q_0.
        # So, the state of qubit 0 is the last character in the outcome string.
        if outcome[-1] == '0':
            P_0 += prob
        elif outcome[-1] == '1':
            P_1 += prob

    # Expectation value <Z0> = P(0) - P(1). This is the raw QNN output [-1, 1]
    expectation_value = P_0 - P_1

    return expectation_value


# --- 6. Hybrid Training (Simplified QNN Loop) ---
print("\n--- 6. Hybrid Training/Optimization (VQE as QNN) ---")
# Initialize random weights for the Qiskit Ansatz
weights = np.random.random(N_ROTATION_WEIGHTS)

# Dummy cost function
def cost(weights, X, y):
    predictions = np.array([qiskit_classifier(weights, x) for x in X])
    return np.mean((predictions - 2*y + 1)**2)

print("Performing quantum prediction with initial weights...")
qnn_raw_output = np.array([qiskit_classifier(weights, x) for x in X_test])

# --- 7. Final Simulation and Risk Detection (Ascery Logic - Ensemble) ---
# Simple Ensemble (using weighted average of probabilities)
xgb_weight = 0.5
qnn_weight = 0.5

# Map QNN raw output [-1, 1] to a probability [0, 1]
qnn_proba = (qnn_raw_output + 1) / 2

hybrid_proba = (xgb_weight * xgb_pred_proba) + (qnn_weight * qnn_proba)
hybrid_predictions = (hybrid_proba > 0.5).astype(int)

# --- 8. Model Performance Metrics and Graphs ---
print("\n--- 8. Model Performance Metrics ---")

def print_metrics(y_true, y_pred, model_name):
    print(f"\n**{model_name} Metrics**")
    print(f"Accuracy: {accuracy_score(y_true, y_pred):.4f}")
    print(f"Precision: {precision_score(y_true, y_pred):.4f}")
    print(f"Recall: {recall_score(y_true, y_pred):.4f}")
    print(f"F1-Score: {f1_score(y_true, y_pred):.4f}")

print_metrics(y_test, hybrid_predictions, "QubitGuard Hybrid Model (Qiskit Core)")

# Confusion Matrix
cm = confusion_matrix(y_test, hybrid_predictions)
print("\n**Confusion Matrix**")
print(cm)

# Performance Metrics Graph (Bar Chart)
metrics_names = ['Accuracy', 'F1-Score', 'AUC']
auc_score = roc_auc_score(y_test, hybrid_proba)
metrics_values = [accuracy_score(y_test, hybrid_predictions), f1_score(y_test, hybrid_predictions), auc_score]

plt.figure(figsize=(7, 5))
plt.bar(metrics_names, metrics_values, color=['skyblue', 'lightcoral', 'lightgreen'])
plt.title('QubitGuard Hybrid Model Performance Metrics')
plt.ylabel('Score')
plt.ylim(0, 1.0)
plt.grid(axis='y', alpha=0.5)
plt.show() # Performance Metrics Graph

# --- 9. Quantum Specific Visualizations (Using Qiskit) ---

## a) Qubits, Circuits (Qiskit Visualization)
print("\n--- 9. Quantum Visualizations (Qiskit) ---")

# Create a Qiskit circuit to visualize the structure
qc_viz = QuantumCircuit(N_QUBITS)
# Encoding Layer: Use fixed small angles for visualization clarity
for i in range(N_QUBITS):
    qc_viz.rx(0.5, i)
for i in range(N_QUBITS - 1):
    qc_viz.cz(i, i+1)
qc_viz.barrier(label='Encoding')

# Variational Layer: Use fixed small angles for visualization clarity
for layer in range(N_LAYERS):
    for i in range(N_QUBITS):
        qc_viz.ry(0.5, i)
    for i in range(N_QUBITS - 1):
        qc_viz.cx(i, i+1)
    qc_viz.barrier(label=f'Layer_{layer+1}')

print("Quantum Circuit (Encoding + Variational HEA):")
display(qc_viz.draw('mpl', filename='quantum_circuit.png', fold=-1)) # Circuit Visualization

## b) Bloch Sphere
print("\nBloch Sphere Visualization (State after Encoding and Ansatz):")

# Use the full circuit with the first test data point and initial weights
qc_state = QuantumCircuit(N_QUBITS)
create_qiskit_ansatz(qc_state, weights, X_test[0], N_QUBITS, N_LAYERS)

statevector = Statevector(qc_state)

# Visualize the state vector on the Bloch Sphere
fig_bloch = plot_bloch_multivector(statevector, reverse_bits=False, title='QubitGuard Bloch Sphere (Qubit States After Full Circuit)')
display(fig_bloch) # Bloch Sphere


# --- 10. Pickle Files (Model Saving) ---
print("\n--- 10. Model Saving (Pickle Files) ---")

# Save XGBoost Model
with open('xgb_model.pkl', 'wb') as f:
    pickle.dump(xgb_model, f)
print("Saved xgb_model.pkl")

# Save QNN Weights
with open('qnn_weights.pkl', 'wb') as f:
    pickle.dump(weights, f)
print("Saved qnn_weights.pkl")
