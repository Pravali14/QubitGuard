        u, v = np.mgrid[0:2*np.pi:20j, 0:np.pi:10j]
        x_sphere = np.cos(u)*np.sin(v)
        y_sphere = np.sin(u)*np.sin(v)
        z_sphere = np.cos(v)
        
        ax = fig.add_subplot(1, config.N_QUBITS, qubit_idx + 1, projection='3d')
        ax.plot_wireframe(x_sphere, y_sphere, z_sphere, color='lightblue', alpha=0.2, linewidth=0.5)
        
        # Plot the Bloch vector
        ax.quiver(0, 0, 0, bloch_vector[0], bloch_vector[1], bloch_vector[2], 
                 color='red', arrow_length_ratio=0.15, linewidth=2.5)
        
        # Add axis lines
        ax.plot([0, 1.2], [0, 0], [0, 0], 'k-', linewidth=0.5, alpha=0.5)
        ax.plot([0, 0], [0, 1.2], [0, 0], 'k-', linewidth=0.5, alpha=0.5)
        ax.plot([0, 0], [0, 0], [0, 1.2], 'k-', linewidth=0.5, alpha=0.5)
        
        # Labels
        ax.text(1.3, 0, 0, 'X', fontsize=10, fontweight='bold')
        ax.text(0, 1.3, 0, 'Y', fontsize=10, fontweight='bold')
        ax.text(0, 0, 1.3, '|0⟩', fontsize=10, fontweight='bold')
        ax.text(0, 0, -1.3, '|1⟩', fontsize=10, fontweight='bold')
        
        ax.set_xlim([-1, 1])
        ax.set_ylim([-1, 1])
        ax.set_zlim([-1, 1])
        ax.set_box_aspect([1,1,1])
        ax.set_title(f'Qubit {qubit_idx}\n⟨X⟩={x_exp:.2f}, ⟨Y⟩={y_exp:.2f}, ⟨Z⟩={z_exp:.2f}', 
                    fontsize=9, fontweight='bold')
        ax.axis('off')
    
    plt.suptitle('Individual Qubit States on Bloch Spheres', fontsize=14, fontweight='bold', y=0.98)
    plt.tight_layout()
    plt.savefig('qubitguard_bloch_sphere_individual.png', dpi=config.DPI, bbox_inches='tight')
    plt.show()
    print(f"✓ Individual Bloch spheres saved: qubitguard_bloch_sphere_individual.png")
    
    # Additional: Show Bloch sphere evolution through circuit layers
    print("\nGenerating Bloch Sphere Evolution Through Circuit Layers...")
    
    fig, axes = plt.subplots(1, 3, figsize=(12, 4), dpi=config.DPI, subplot_kw={'projection': '3d'})
    
    # State 1: After initialization (all |0⟩)
    qc_init = QuantumCircuit(config.N_QUBITS)
    sv_init = Statevector(qc_init)
    
    # State 2: After encoding
    qc_encode = QuantumCircuit(config.N_QUBITS)
    for i in range(config.N_QUBITS):
        qc_encode.rx(X_test[0][i], i)
    for i in range(config.N_QUBITS - 1):
        qc_encode.cz(i, i+1)
    sv_encode = Statevector(qc_encode)
    
    # State 3: After full circuit (encoding + variational)
    sv_full = statevector
    
    states = [
        (sv_init, 'Initial State |0000⟩', 0),
        (sv_encode, 'After Encoding', 1),
        (sv_full, 'After Full Circuit', 2)
    ]
    
    for sv, title, idx in states:
        # Calculate Bloch vector for qubit 0
        pauli_x = Pauli('X' + 'I' * (config.N_QUBITS - 1))
        pauli_y = Pauli('Y' + 'I' * (config.N_QUBITS - 1))
        pauli_z = Pauli('Z' + 'I' * (config.N_QUBITS - 1))
        
        x_exp = sv.expectation_value(pauli_x).real
        y_exp = sv.expectation_value(pauli_y).real
        z_exp = sv.expectation_value(pauli_z).real
        
        bloch_vector = [x_exp, y_exp, z_exp]
        
        ax = axes[idx]
        
        # Draw sphere
        u, v = np.mgrid[0:2*np.pi:20j, 0:np.pi:10j]
        x_sphere = np.cos(u)*np.sin(v)
        y_sphere = np.sin(u)*np.sin(v)
        z_sphere = np.cos(v)
        ax.plot_wireframe(x_sphere, y_sphere, z_sphere, color='lightblue', alpha=0.2, linewidth=0.5)
        
        # Draw vector
        ax.quiver(0, 0, 0, bloch_vector[0], bloch_vector[1], bloch_vector[2], 
                 color=['green', 'orange', 'red'][idx], arrow_length_ratio=0.15, linewidth=3)
        
        # Axes
        ax.plot([0, 1.2], [0, 0], [0, 0], 'k-', linewidth=0.5, alpha=0.5)
        ax.plot([0, 0], [0, 1.2], [0, 0], 'k-', linewidth=0.5, alpha=0.5)
        ax.plot([0, 0], [0, 0], [0, 1.2], 'k-', linewidth=0.5, alpha=0.5)
        
        ax.text(1.3, 0, 0, 'X', fontsize=10, fontweight='bold')
        ax.text(0, 1.3, 0, 'Y', fontsize=10, fontweight='bold')
        ax.text(0, 0, 1.3, '|0⟩', fontsize=10, fontweight='bold')
        ax.text(0, 0, -1.3, '|1⟩', fontsize=10, fontweight='bold')
        
        ax.set_xlim([-1, 1])
        ax.set_ylim([-1, 1])
        ax.set_zlim([-1, 1])
        ax.set_box_aspect([1,1,1])
        ax.set_title(f'{title}\n⟨Z⟩={z_exp:.3f}', fontsize=10, fontweight='bold')
        ax.axis('off')
    
    plt.suptitle('Qubit 0 State Evolution', fontsize=14, fontweight='bold')
    plt.tight_layout()
    plt.savefig('qubitguard_bloch_evolution.png', dpi=config.DPI, bbox_inches='tight')
    plt.show()
    print("✓ Bloch sphere evolution saved: qubitguard_bloch_evolution.png")
    
except Exception as e:
    print(f"⚠ Bloch sphere visualization encountered error: {e}")
    import traceback
    traceback.print_exc()

